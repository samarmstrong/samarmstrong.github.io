---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} image={`/og/${post.id}.png`} type="article">
  <article>
    <h1>{post.data.title}</h1>
    <p class="muted">
      <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
      {post.data.updated && <> · updated <time datetime={post.data.updated.toISOString()}>{post.data.updated.toISOString().slice(0, 10)}</time></>}
      {post.data.draft && <span class="badge">draft</span>}
    </p>
    <div class="prose"><Content /></div>
  </article>
</Base>
